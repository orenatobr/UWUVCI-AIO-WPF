<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UWUVCI.Mac.ViewModels"
             x:Class="UWUVCI.Mac.Views.BasePage"
             x:DataType="vm:MainViewModel">
  <StackPanel Spacing="24">
    <StackPanel Spacing="4">
      <TextBlock Text="Choose a base" Classes="title" />
      <TextBlock Classes="muted"
                 Text="The base is the Wii U game your ROM is injected into. You supply it. The app ships none." />
    </StackPanel>

    <Border Classes="card" IsVisible="{Binding Inject.IsNative}">
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Not needed. The native engine does not use a Nintendo base." />
    </Border>

    <StackPanel Spacing="24" IsVisible="{Binding Inject.IsBaseRequired}">
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Text="Base game" Classes="section" />
        <TextBlock Classes="muted"
                   Text="Pick the Wii U game to inject into. It downloads when you choose it, using the title key you enter once." />
        <ComboBox x:Name="BaseCombo" ItemsSource="{Binding Inject.BaseOptions}"
                  SelectedItem="{Binding Inject.SelectedOption, Mode=OneWay}"
                  SelectionChanged="OnBaseSelected" IsEnabled="{Binding !Inject.IsDownloading}"
                  HorizontalAlignment="Left" Width="460" MinHeight="36"
                  AutomationProperties.Name="Base game">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BaseOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Spacing="8" IsVisible="{Binding Inject.ShowKeyField}">
          <TextBlock Text="Title key (32 hex characters)" Classes="label" />
          <TextBox Text="{Binding Inject.BaseKeyInput}" PasswordChar="•" MaxLength="32" Width="460"
                   HorizontalAlignment="Left" FontFamily="Menlo,Monaco,monospace"
                   AutomationProperties.Name="Title key" />
          <TextBlock Text="{Binding Inject.BaseKeyError}" Classes="error"
                     IsVisible="{Binding Inject.BaseKeyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="muted" Text="The key is checked here and kept on this Mac, so you only enter it once." />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding Inject.ShowCommonKeyHint}">
          <TextBlock Classes="error" Text="Downloads need your Wii U common key." />
          <Button Classes="link" Content="Open Settings to add it" Command="{Binding OpenSettingsCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding Inject.ShowDownload}">
          <Button Content="{Binding Inject.DownloadButtonText}" Classes="accent"
                  Command="{Binding Inject.DownloadSelectedBaseCommand}" AutomationProperties.Name="Download base" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding Inject.IsDownloading}">
          <ProgressBar Value="{Binding Inject.Percent}" Maximum="100" AutomationProperties.Name="Download progress" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding Inject.ProgressMessage}" Classes="muted" VerticalAlignment="Center" />
            <Button Content="Cancel" Command="{Binding Inject.CancelCommand}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="Base ready." Foreground="{DynamicResource SuccessText}"
                   IsVisible="{Binding Inject.IsBaseValid}" />
        <TextBlock Text="{Binding Inject.BaseError}" Classes="error"
                   IsVisible="{Binding Inject.BaseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <StackPanel Spacing="8">
      <TextBlock Text="Already have a decrypted base?" Classes="muted" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Use a decrypted base folder..." Click="OnChooseFolder"
                AutomationProperties.Name="Choose base folder" />
        <TextBlock Text="{Binding Inject.BaseDir}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="360" IsVisible="{Binding Inject.IsCustomBase}" />
      </StackPanel>
      <TextBlock Classes="muted" Text="The folder must contain code, content and meta." />
    </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
