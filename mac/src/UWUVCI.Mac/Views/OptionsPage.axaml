<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UWUVCI.Mac.ViewModels"
             x:Class="UWUVCI.Mac.Views.OptionsPage"
             x:DataType="vm:MainViewModel">
  <StackPanel Spacing="24">
    <StackPanel Spacing="4">
      <TextBlock Text="Nintendo 64 options" Classes="title" />
      <TextBlock Classes="muted" Text="The defaults suit most games. Change them only if you know you need to." />
    </StackPanel>

    <Border Classes="card">
      <StackPanel Spacing="16">
        <ToggleSwitch IsChecked="{Binding Inject.WideScreen}" OnContent="Widescreen (16:9)" OffContent="Widescreen (16:9)"
                      AutomationProperties.Name="Widescreen" />
        <ToggleSwitch IsChecked="{Binding Inject.DarkFilter}" OnContent="Remove dark filter" OffContent="Remove dark filter"
                      AutomationProperties.Name="Remove dark filter" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="Expansion Pak (experimental)" Classes="section" />
        <TextBlock Classes="muted"
                   Text="Auto follows the game profile. On adds the 4 MB Expansion Pak to the ini, off removes it. No published ini sets it, so results for games that need it are not guaranteed." />
        <ListBox ItemsSource="{Binding Inject.PakChoices}" SelectedItem="{Binding Inject.PakChoice}"
                 AutomationProperties.Name="Expansion Pak choice">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PakChoice">
              <TextBlock Text="{Binding}" MinWidth="56" TextAlignment="Center" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="Custom ini (optional)" Classes="section" />
        <TextBlock Classes="muted" Text="A hand written ini replaces the automatic profile. Text file, up to 16 MiB." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Choose ini..." Click="OnChoose" AutomationProperties.Name="Choose custom ini" />
          <Button Content="Remove" Click="OnRemove" IsVisible="{Binding Inject.CustomIniPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <TextBlock Text="{Binding Inject.CustomIniPath}" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding Inject.CustomIniPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Inject.CustomIniError}" Classes="error"
                   IsVisible="{Binding Inject.CustomIniError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
